# Copy this file to the repo root as `.env` and edit DEEPSEEK_API_KEY.
# backend/app/config.py resolves the repo-root .env regardless of CWD,
# so there is exactly one env file for the whole project.
DEEPSEEK_API_KEY=your_api_key_here
MILVUS_URI=http://localhost:19530
MILVUS_COLLECTION=knowledge_base
MILVUS_NPROBE=32

BGE_MODEL_PATH=BAAI/bge-m3
BGE_DEVICE=cuda
RERANKER_MODEL_PATH=BAAI/bge-reranker-v2-m3
RERANKER_DEVICE=cuda
# HYBRID_*_TOP_K / RRF_K / HYBRID_FUSION_TOP_K tune recall vs latency;
# RERANKER_TOP_N is how many chunks survive the reranker.
HYBRID_DENSE_TOP_K=50
HYBRID_SPARSE_TOP_K=50
RRF_K=60
HYBRID_FUSION_TOP_K=30
RERANKER_TOP_N=10
SKIP_MODELS=0

# Chunking (parent-child): parents hold the context, children are indexed
PARENT_CHUNK_SIZE=1000
CHILD_CHUNK_SIZE=250
CHUNK_OVERLAP=100

# Uploads; relative paths resolve against the repo root, not the CWD
UPLOAD_DIR=backend/uploads
MAX_UPLOAD_SIZE_MB=50

# Agentic RAG (corrective loop + tool loop)
AGENT_HISTORY_TURNS=6
AGENT_MAX_ITERATIONS=2
AGENT_MAX_TOOL_CALLS=3
# On a corrective retry the retrieval window is widened to this many
# candidates (never narrower than HYBRID_FUSION_TOP_K).
AGENT_RETRY_FUSION_TOP_K=50
# Chunks from at most this many distinct documents reach the grade/generate
# prompts (retrieval itself is unaffected).
CONTEXT_MAX_DOCS=5
# Conversation memory: sqlite persists across restarts, memory does not.
AGENT_CHECKPOINTER_BACKEND=sqlite
AGENT_CHECKPOINTER_PATH=backend/data/checkpoints.sqlite
